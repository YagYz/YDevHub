# ============================================================================
# ⚡ YDevHub — Sunucu & Uygulama Yapılandırma Dosyası (.env)
# ============================================================================

# 1. Uygulamanın Dışarıya Açılacağı Port (Örn: 3080, 3000, 8090)
APP_PORT=3080

# 2. Veritabanı (ydevhub.db) ve Yüklenen Görsellerin Sunucuda Depolanacağı Tam Yol
# CasaOS / Homelab standart yolu: /DATA/AppData/ydevhub
# Yerel klasör için: ./data
HOST_DATA_DIR=/DATA/AppData/ydevhub

# 3. Yerel DNS (AdGuard Home / Local) Domain Adresleri
LOCAL_DOMAIN=ydevhub.yagyz.server
SECONDARY_LOCAL_DOMAIN=ydevhub.local

# 4. Harici (Gerçek) Domain Adresi (İleride gerçek domain bağlandığında buraya yazabilirsin)
# Boş bırakıldığında hem IP hem Local DNS hem de bağlanan tüm domainlerle otomatik çalışır
PUBLIC_DOMAIN=

# 5. Maksimum Görsel Yükleme Boyutu (MB)
MAX_UPLOAD_MB=8

# 6. Watchtower Otomatik Güncelleme Kontrol Süresi (Saniye)
WATCHTOWER_POLL_INTERVAL=60

# 7. Telegram Asistan & Bildirim Botu Ayarları
# Telegram'da @BotFather üzerinden alınan bot token
TELEGRAM_BOT_TOKEN=
# Botun sadece sana hizmet vermesi için Telegram Chat ID (boş bırakırsan botla ilk /start yapan kişi yönetici olur)
TELEGRAM_CHAT_ID=


#!/usr/bin/env bash
# ==============================================================================
# ⚡ ydev — YDevHub & Homelab CLI İstemcisi
# Desteklenen Platformlar: Linux & macOS (Darwin)
# Mimari: Kişisel Bilgisayar (Client) -> Uzak Sunucu REST API / Docker
# ==============================================================================
set -e

CONFIG_FILE="${HOME}/.config/ydevhub/config.json"
DEFAULT_URL="http://10.10.50.1:3080"
DEFAULT_KEY="ydh_ed604d18a7a0ebf0c03865c47499206bcdf0c83d"
DEFAULT_YNETMON_URL="http://10.10.50.1:8765"
DEFAULT_YNETMON_KEY="ynetmon_secret_hub_key_2026"

# Python 3 / jq Hybrid JSON parser (Zero external dependencies on clean macOS/Linux)
HAS_JQ="false"
if command -v jq >/dev/null 2>&1; then
  HAS_JQ="true"
fi

function parse_json() {
  if [ "$HAS_JQ" = "true" ]; then
    jq "$@"
  else
    python3 -c "
import sys, json

args = sys.argv[1:]
raw = '-r' in args
args = [a for a in args if a not in ('-r', '-e', '-c')]

expr = args[0] if args else '.'
try:
    c = sys.stdin.read().strip()
    data = json.loads(c) if c else None
except Exception:
    sys.exit(1)

def resolve(val, query):
    if not query or query == '.':
        return val
    parts = [p for p in query.strip('.').split('.') if p]
    cur = val
    for p in parts:
        if isinstance(cur, dict):
            cur = cur.get(p)
        else:
            return None
    return cur

res = resolve(data, expr)
if res is None:
    sys.exit(1)
if raw and isinstance(res, str):
    print(res)
else:
    print(json.dumps(res, ensure_ascii=False))
" "$@"
  fi
}

# Read config from file or environment
if [ -f "$CONFIG_FILE" ]; then
  API_URL=$(parse_json -r '.api_url // empty' < "$CONFIG_FILE" 2>/dev/null || true)
  API_KEY=$(parse_json -r '.api_key // empty' < "$CONFIG_FILE" 2>/dev/null || true)
  YNETMON_URL=$(parse_json -r '.ynetmon_url // empty' < "$CONFIG_FILE" 2>/dev/null || true)
  YNETMON_KEY=$(parse_json -r '.ynetmon_key // empty' < "$CONFIG_FILE" 2>/dev/null || true)
fi

API_URL="${YDEVHUB_API_URL:-${API_URL:-$DEFAULT_URL}}"
API_KEY="${YDEVHUB_API_KEY:-${API_KEY:-$DEFAULT_KEY}}"
YNETMON_URL="${YNETMON_URL:-${YNETMON_URL:-$DEFAULT_YNETMON_URL}}"
YNETMON_KEY="${YNETMON_KEY:-${YNETMON_KEY:-$DEFAULT_YNETMON_KEY}}"

# Terminal Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[32m"
C_BLUE="\033[34m"
C_YELLOW="\033[33m"
C_CYAN="\033[36m"
C_RED="\033[31m"
C_GRAY="\033[90m"
C_MAGENTA="\033[35m"

function show_help() {
  echo -e "${C_BOLD}⚡ YDevHub & Homelab CLI (${API_URL})${C_RESET}"
  echo -e "${C_GRAY}Linux & macOS destekli uzaktan kontrol ve yönetim aracı${C_RESET}"
  echo ""
  echo -e "${C_BOLD}KULLANIM:${C_RESET}"
  echo "  ydev <komut> [seçenekler]"
  echo ""
  echo -e "${C_BOLD}📝 NOT YÖNETİMİ:${C_RESET}"
  echo "  ydev note <içerik> [-p low|med|high] [--due HH:MM] [--date YYYY-MM-DD]"
  echo "       Not ekler (alias: not)"
  echo "  ydev notes [--limit N] [--date YYYY-MM-DD] [--pending|--done|--all]"
  echo "       Notları listeler (alias: notlar)"
  echo "  ydev note-done <id>"
  echo "       Notu tamamlandı olarak işaretler (alias: not-yapildi)"
  echo ""
  echo -e "${C_BOLD}📋 GÖREV YÖNETİMİ:${C_RESET}"
  echo "  ydev task <başlık> [-d <açıklama>] [-p low|med|high] [--due YYYY-MM-DD]"
  echo "       Görev ekler (alias: gorev)"
  echo "  ydev tasks [--status todo|in_progress|done] [--limit N]"
  echo "       Görevleri listeler (alias: gorevler)"
  echo "  ydev task-done <id>"
  echo "       Görevi tamamlar (alias: gorev-yapildi)"
  echo ""
  echo -e "${C_BOLD}🌐 AĞ & YNETMON (Canlı Ağ Analitiği):${C_RESET}"
  echo "  ydev net | ynetmon"
  echo "       Canlı bant genişliği, aktif soket ve güvenlik alarmları özeti"
  echo "  ydev net-alerts | alerts [--limit N]"
  echo "       Son güvenlik ve aşırı bant genişliği uyarılarını listeler"
  echo "  ydev net-devices | devices [--limit N] [--all]"
  echo "       Ağdaki aktif ve kayıtlı cihazları/konteynerleri listeler"
  echo ""
  echo -e "${C_BOLD}🚀 KURULUM & DAĞITIM:${C_RESET}"
  echo "  ydev install cli"
  echo "       Kişisel bilgisayara (Linux/macOS) ydev komutunu kurar ve API ayarlarını yapar"
  echo "  ydev install stack | server"
  echo "       Homelab sunucusunda YDevHub, YNetMon ve Watchtower hazır stack kurar (GHCR)"
  echo ""
  echo -e "${C_BOLD}⚡ HIZLI İŞLEM & SİSTEM:${C_RESET}"
  echo "  ydev quick <metin>"
  echo "       Doğal metinden otomatik not/görev ayrıştır (alias: q)"
  echo "  ydev status | ping"
  echo "       YDevHub ve YNetMon API bağlantılarını test eder"
  echo "  ydev config"
  echo "       Mevcut bağlantı ve API anahtarı ayarlarını görüntüler"
}

function req() {
  local method="$1"
  local endpoint="$2"
  local body="$3"

  local curl_args=(
    -s
    -X "$method"
    "${API_URL}${endpoint}"
    -H "X-API-Key: ${API_KEY}"
    -H "Content-Type: application/json"
    --connect-timeout 4
    --max-time 10
  )

  if [ -n "$body" ]; then
    curl_args+=(-d "$body")
  fi

  local resp
  resp=$(curl "${curl_args[@]}" 2>/dev/null || true)
  if [ -z "$resp" ]; then
    echo -e "${C_RED}❌ Hata: YDevHub sunucusuna erişilemedi (${API_URL})${C_RESET}" >&2
    exit 1
  fi
  echo "$resp"
}

function ynetmon_req() {
  local endpoint="$1"
  local resp
  resp=$(curl -s \
    -X GET \
    "${YNETMON_URL}${endpoint}" \
    -H "X-API-Key: ${YNETMON_KEY}" \
    -H "Content-Type: application/json" \
    --connect-timeout 4 \
    --max-time 10 2>/dev/null || true)

  if [ -z "$resp" ]; then
    echo -e "${C_RED}❌ Hata: YNetMon servisine erişilemedi (${YNETMON_URL})${C_RESET}" >&2
    exit 1
  fi
  echo "$resp"
}

function format_bps() {
  local bps="${1:-0}"
  awk -v b="$bps" 'BEGIN {
    if (b >= 1000000000) printf "%.2f Gbps", b / 1000000000;
    else if (b >= 1000000) printf "%.2f Mbps", b / 1000000;
    else if (b >= 1000) printf "%.1f Kbps", b / 1000;
    else printf "%d bps", b;
  }'
}

function format_bytes() {
  local bytes="${1:-0}"
  awk -v b="$bytes" 'BEGIN {
    if (b >= 1073741824) printf "%.2f GB", b / 1073741824;
    else if (b >= 1048576) printf "%.2f MB", b / 1048576;
    else if (b >= 1024) printf "%.1f KB", b / 1024;
    else printf "%d B", b;
  }'
}

cmd="${1:-}"
shift || true

case "$cmd" in
  note|not)
    content=""
    priority="medium"
    due_time=""
    date=""

    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--priority) priority="$2"; shift 2 ;;
        --due) due_time="$2"; shift 2 ;;
        --date) date="$2"; shift 2 ;;
        *)
          if [ -z "$content" ]; then
            content="$1"
          else
            content="${content} $1"
          fi
          shift
          ;;
      esac
    done

    if [ -z "$content" ]; then
      echo -e "${C_RED}❌ Hata: Not içeriği boş olamaz.${C_RESET}" >&2
      exit 1
    fi

    payload=$(python3 -c "
import json, sys
data = {
    'content': sys.argv[1],
    'priority': sys.argv[2],
    'due_time': sys.argv[3],
    'source': 'cli'
}
if sys.argv[4]:
    data['date'] = sys.argv[4]
print(json.dumps(data))
" "$content" "$priority" "$due_time" "$date")

    res=$(req POST "/api/v1/notes" "$payload")

    if echo "$res" | grep -q '"success":true'; then
      id=$(echo "$res" | parse_json -r '.note.id')
      date=$(echo "$res" | parse_json -r '.note.date')
      echo -e "${C_GREEN}✔ Not eklendi [#${id}] (${date})${C_RESET}"
      echo "  ${content}"
    else
      err=$(echo "$res" | parse_json -r '.error // "Bilinmeyen hata"')
      echo -e "${C_RED}❌ Not eklenemedi: ${err}${C_RESET}" >&2
      exit 1
    fi
    ;;

  notes|notlar)
    limit=15
    date=""
    status_filter="all"

    while [ $# -gt 0 ]; do
      case "$1" in
        -l|--limit) limit="$2"; shift 2 ;;
        -d|--date) date="$2"; shift 2 ;;
        --pending) status_filter="pending"; shift ;;
        --done) status_filter="done"; shift ;;
        --all) status_filter="all"; shift ;;
        *) shift ;;
      esac
    done

    query="limit=${limit}"
    [ -n "$date" ] && query="${query}&date=${date}"
    [ "$status_filter" != "all" ] && query="${query}&status=${status_filter}"

    res=$(req GET "/api/v1/notes?${query}")

    if ! echo "$res" | grep -q '"success":true'; then
      err=$(echo "$res" | parse_json -r '.error // "Bilinmeyen hata"')
      echo -e "${C_RED}❌ Notlar alınamadı: ${err}${C_RESET}" >&2
      exit 1
    fi

    python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
notes = data.get('notes', [])
print(f'📝 Günlük Notlar ({len(notes)} kayıt):')
for n in notes:
    icon = '✔' if n.get('is_done') else '○'
    time_str = f\" [⏰ {n['due_time']}]\" if n.get('due_time') else ''
    print(f\"[{n['id']}] {n.get('date', '')} {icon} [{n.get('priority', 'medium')}]{time_str} {n.get('content', '')}\")
" <<< "$res"
    ;;

  note-done|not-yapildi)
    id="${1:-}"
    if [ -z "$id" ]; then
      echo -e "${C_RED}❌ Hata: Not ID belirtilmedi.${C_RESET}" >&2
      exit 1
    fi
    res=$(req PATCH "/api/v1/notes" "{\"id\":${id},\"is_done\":true}")
    if echo "$res" | grep -q '"success":true'; then
      echo -e "${C_GREEN}✔ Not [#${id}] tamamlandı olarak işaretlendi.${C_RESET}"
    else
      echo -e "${C_RED}❌ Not tamamlanamadı.${C_RESET}" >&2
      exit 1
    fi
    ;;

  task|gorev)
    title=""
    desc=""
    priority="medium"
    due_date=""

    while [ $# -gt 0 ]; do
      case "$1" in
        -d|--desc) desc="$2"; shift 2 ;;
        -p|--priority) priority="$2"; shift 2 ;;
        --due) due_date="$2"; shift 2 ;;
        *)
          if [ -z "$title" ]; then
            title="$1"
          else
            title="${title} $1"
          fi
          shift
          ;;
      esac
    done

    if [ -z "$title" ]; then
      echo -e "${C_RED}❌ Hata: Görev başlığı boş olamaz.${C_RESET}" >&2
      exit 1
    fi

    payload=$(python3 -c "
import json, sys
data = {
    'title': sys.argv[1],
    'description': sys.argv[2],
    'priority': sys.argv[3],
    'due_date': sys.argv[4] if sys.argv[4] else None
}
print(json.dumps(data))
" "$title" "$desc" "$priority" "$due_date")

    res=$(req POST "/api/v1/tasks" "$payload")

    if echo "$res" | grep -q '"success":true'; then
      id=$(echo "$res" | parse_json -r '.task.id')
      echo -e "${C_GREEN}✔ Görev eklendi [#${id}]${C_RESET}"
      echo "  ${title}"
    else
      err=$(echo "$res" | parse_json -r '.error // "Bilinmeyen hata"')
      echo -e "${C_RED}❌ Görev eklenemedi: ${err}${C_RESET}" >&2
      exit 1
    fi
    ;;

  tasks|gorevler)
    limit=15
    status=""

    while [ $# -gt 0 ]; do
      case "$1" in
        -l|--limit) limit="$2"; shift 2 ;;
        -s|--status) status="$2"; shift 2 ;;
        *) shift ;;
      esac
    done

    query="limit=${limit}"
    [ -n "$status" ] && query="${query}&status=${status}"

    res=$(req GET "/api/v1/tasks?${query}")

    if ! echo "$res" | grep -q '"success":true'; then
      err=$(echo "$res" | parse_json -r '.error // "Bilinmeyen hata"')
      echo -e "${C_RED}❌ Görevler alınamadı: ${err}${C_RESET}" >&2
      exit 1
    fi

    python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
tasks = data.get('tasks', [])
print(f'📋 Görev Listesi ({len(tasks)} kayıt):')
for t in tasks:
    time_str = f\" [⏰ {t['due_date']}]\" if t.get('due_date') else ''
    print(f\"[{t['id']}] [{t.get('status', 'todo')}] [{t.get('priority', 'medium')}]{time_str} {t.get('title', '')}\")
" <<< "$res"
    ;;

  task-done|gorev-yapildi)
    id="${1:-}"
    if [ -z "$id" ]; then
      echo -e "${C_RED}❌ Hata: Görev ID belirtilmedi.${C_RESET}" >&2
      exit 1
    fi
    res=$(req POST "/api/v1/tasks" "{\"action\":\"done\",\"id\":${id}}")
    if echo "$res" | grep -q '"success":true'; then
      echo -e "${C_GREEN}✔ Görev [#${id}] tamamlandı olarak işaretlendi.${C_RESET}"
    else
      echo -e "${C_RED}❌ Görev tamamlanamadı.${C_RESET}" >&2
      exit 1
    fi
    ;;

  quick|q)
    text="$*"
    if [ -z "$text" ]; then
      echo -e "${C_RED}❌ Hata: Metin belirtilmedi.${C_RESET}" >&2
      exit 1
    fi

    payload=$(python3 -c "import json, sys; print(json.dumps({'text': sys.argv[1]}))" "$text")
    res=$(req POST "/api/v1/quick" "$payload")

    if echo "$res" | grep -q '"success":true'; then
      type=$(echo "$res" | parse_json -r '.type')
      id=$(echo "$res" | parse_json -r '.data.id')
      echo -e "${C_GREEN}✔ Otomatik ${type} oluşturuldu [#${id}]${C_RESET}"
    else
      echo -e "${C_RED}❌ Ayrıştırma başarısız oldu.${C_RESET}" >&2
      exit 1
    fi
    ;;

  net|ynetmon)
    res=$(ynetmon_req "/api/v1/integration/summary")

    rx_raw=$(echo "$res" | parse_json -r '.rx_bps // 0')
    tx_raw=$(echo "$res" | parse_json -r '.tx_bps // 0')
    rx_fmt=$(format_bps "$rx_raw")
    tx_fmt=$(format_bps "$tx_raw")

    active_conns=$(echo "$res" | parse_json -r '.active_connections // 0')
    containers=$(echo "$res" | parse_json -r '.docker_containers // 0')
    active_devs=$(echo "$res" | parse_json -r '.storage.active_devices_count // .storage.devices_count // 0')
    total_devs=$(echo "$res" | parse_json -r '.storage.total_devices_count // 0')
    alerts_count=$(echo "$res" | parse_json -r '.storage.alerts_count // 0')
    db_size=$(echo "$res" | parse_json -r '.storage.db_size_mb // 0')
    cap_mode=$(echo "$res" | parse_json -r '.capture_mode // "N/A"')

    echo -e "${C_BOLD}🌐 YNetMon Ağ Durumu & Trafik Analizi (${YNETMON_URL})${C_RESET}"
    echo -e "  İndirme (RX):    ${C_GREEN}${rx_fmt}${C_RESET}"
    echo -e "  Yükleme (TX):    ${C_CYAN}${tx_fmt}${C_RESET}"
    echo -e "  Aktif Bağlantı:  ${C_BOLD}${active_conns}${C_RESET}"
    echo -e "  Cihazlar:        ${C_BOLD}${active_devs}${C_RESET} aktif / ${total_devs} toplam"
    echo -e "  Konteynerler:    ${C_BOLD}${containers}${C_RESET} Docker izleniyor"
    echo -e "  Yakalama Modu:   ${C_YELLOW}${cap_mode}${C_RESET}"
    echo -e "  Veritabanı:      ${db_size} MB | ${alerts_count} Güvenlik Uyarısı"

    python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
alerts = data.get('recent_alerts', [])
if alerts:
    print('\n  ⚠️ Son Uyarılar:')
    for a in alerts[:3]:
        print(f\"    • [{a.get('severity','').upper()}] {a.get('rule_name','')}: {a.get('message','')}\")
" <<< "$res"
    ;;

  net-alerts|alerts)
    limit=10
    while [ $# -gt 0 ]; do
      case "$1" in
        -l|--limit) limit="$2"; shift 2 ;;
        *) shift ;;
      esac
    done

    res=$(ynetmon_req "/api/v1/integration/alerts?limit=${limit}")
    python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
alerts = data.get('alerts', [])
print(f'🚨 YNetMon Güvenlik & Trafik Uyarıları ({len(alerts)} kayıt):')
if not alerts:
    print('  Aktif uyarı bulunmuyor. Ağ temiz.')
for a in alerts:
    sev = a.get('severity', 'info').upper()
    src = a.get('src_ip', '-')
    print(f\"  [{sev}] {a.get('rule_name', 'Uyarı')} ({src})\")
    print(f\"    {a.get('message', '')}\")
" <<< "$res"
    ;;

  net-devices|devices)
    show_all="false"
    limit=20
    while [ $# -gt 0 ]; do
      case "$1" in
        -l|--limit) limit="$2"; shift 2 ;;
        --all) show_all="true"; shift ;;
        *) shift ;;
      esac
    done

    res=$(ynetmon_req "/api/v1/integration/devices")
    python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
devices = data.get('devices', [])
active_c = data.get('active_count', 0)
total_c = data.get('count', 0)
print(f'📱 YNetMon Ağ Cihazları ({active_c} aktif / {total_c} toplam):')

show_all = '$show_all' == 'true'
lim = int('$limit')
filtered = devices if show_all else [d for d in devices if d.get('is_online')]

def fmt_bytes(b):
    if b >= 1073741824: return f'{b/1073741824:.2f} GB'
    if b >= 1048576: return f'{b/1048576:.2f} MB'
    if b >= 1024: return f'{b/1024:.1f} KB'
    return f'{b} B'

for d in filtered[:lim]:
    ip = d.get('ip', '-')
    online = '● Aktif' if d.get('is_online') else '○ Çevrimdışı'
    dev_type = f\"[{d.get('device_type', 'LAN')}]\"
    name = d.get('container_name') or d.get('vendor') or 'Bilinmeyen'
    b_fmt = fmt_bytes(d.get('total_bytes', 0))
    print(f'  {ip:<15} {online:<14} {dev_type:<8} {name:<26} {b_fmt:>10}')
" <<< "$res"
    ;;

  install)
    subcmd="${1:-cli}"
    shift || true

    case "$subcmd" in
      cli)
        echo -e "${C_BOLD}🚀 YDevHub CLI Yerel Kurulum Sihirbazı (Linux & macOS)${C_RESET}\n"
        TARGET_BIN="/usr/local/bin"
        if [ "$(id -u)" -ne 0 ]; then
          TARGET_BIN="${HOME}/.local/bin"
        fi
        mkdir -p "${TARGET_BIN}"
        cp "$0" "${TARGET_BIN}/ydev"
        chmod +x "${TARGET_BIN}/ydev"
        echo -e "${C_GREEN}✔ 'ydev' komutu '${TARGET_BIN}/ydev' dizinine kopyalandı.${C_RESET}"

        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo -e "\n${C_BOLD}⚙️  API Bağlantı Yapılandırması:${C_RESET}"
        read -r -p "  YDevHub API URL [${DEFAULT_URL}]: " input_url
        input_url="${input_url:-$DEFAULT_URL}"

        read -r -p "  YDevHub API Key [${DEFAULT_KEY}]: " input_key
        input_key="${input_key:-$DEFAULT_KEY}"

        read -r -p "  YNetMon API URL [${DEFAULT_YNETMON_URL}]: " input_ynet_url
        input_ynet_url="${input_ynet_url:-$DEFAULT_YNETMON_URL}"

        read -r -p "  YNetMon API Key [${DEFAULT_YNETMON_KEY}]: " input_ynet_key
        input_ynet_key="${input_ynet_key:-$DEFAULT_YNETMON_KEY}"

        python3 -c "
import json, sys
cfg = {
    'api_url': sys.argv[1],
    'api_key': sys.argv[2],
    'ynetmon_url': sys.argv[3],
    'ynetmon_key': sys.argv[4]
}
with open('$CONFIG_FILE', 'w', encoding='utf-8') as f:
    json.dump(cfg, f, indent=2)
" "$input_url" "$input_key" "$input_ynet_url" "$input_ynet_key"

        echo -e "\n${C_GREEN}✔ Ayarlar kaydedildi: ${CONFIG_FILE}${C_RESET}"
        ;;

      stack|server)
        echo -e "${C_BOLD}🐳 YDevHub & YNetMon Sunucu Stack Kurulum Sihirbazı${C_RESET}"
        echo -e "${C_GRAY}Homelab sunucuları için GHCR hazır konteyner dağıtımı (Derleme yapmaz)${C_RESET}\n"

        read -r -p "  Stack nereye kurulsun? [./homelab-stack]: " target_dir
        target_dir="${target_dir:-./homelab-stack}"
        mkdir -p "$target_dir"

        read -r -p "  YDevHub Port [3080]: " port_hub
        port_hub="${port_hub:-3080}"

        read -r -p "  YNetMon Port [8765]: " port_ynet
        port_ynet="${port_ynet:-8765}"

        read -r -p "  YNetMon API Secret Key [ynetmon_secret_hub_key_2026]: " secret_ynet
        secret_ynet="${secret_ynet:-ynetmon_secret_hub_key_2026}"

        cat << EOF > "${target_dir}/docker-compose.yml"
services:
  ydevhub:
    image: ghcr.io/yagyz/ydevhub:latest
    container_name: ydevhub-app
    restart: unless-stopped
    ports:
      - "${port_hub}:3000"
    environment:
      - NODE_ENV=production
      - DB_DIR=/app/data
      - DB_PATH=/app/data/ydevhub.db
      - APP_PORT=${port_hub}
      - HOST_DATA_DIR=\${HOST_DATA_DIR:-/DATA/AppData/ydevhub}
      - TZ=Europe/Istanbul
    volumes:
      - \${HOST_DATA_DIR:-/DATA/AppData/ydevhub}:/app/data
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/localtime:/etc/localtime:ro
    labels:
      - "com.centurylinklabs.watchtower.enable=true"

  ynetmon:
    image: ghcr.io/yagyz/ynetmon:latest
    container_name: ynetmon-app
    restart: unless-stopped
    network_mode: host
    pid: host
    cap_add:
      - NET_ADMIN
      - NET_RAW
      - SYS_PTRACE
      - DAC_READ_SEARCH
    security_opt:
      - apparmor:unconfined
    volumes:
      - /DATA/AppData/ynetmon:/app/data
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/localtime:/etc/localtime:ro
      - /etc/timezone:/etc/timezone:ro
    environment:
      - TZ=Europe/Istanbul
      - YNETMON_PORT=${port_ynet}
      - YNETMON_DB=/app/data/ynetmon.db
    labels:
      - "com.centurylinklabs.watchtower.enable=true"

  watchtower:
    image: containrrr/watchtower
    container_name: ydevhub-watchtower
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /etc/localtime:/etc/localtime:ro
    environment:
      - WATCHTOWER_CLEANUP=true
      - WATCHTOWER_LABEL_ENABLE=true
      - WATCHTOWER_POLL_INTERVAL=60
      - TZ=Europe/Istanbul
EOF

        echo -e "\n${C_GREEN}✔ Hazır docker-compose.yml dosyası oluşturuldu: ${target_dir}/docker-compose.yml${C_RESET}"
        if command -v docker >/dev/null 2>&1; then
          read -r -p "  Servisler şimdi ayağa kaldırılsın mı? (E/h): " start_now
          if [[ "${start_now,,}" =~ ^(e|evet|y|yes|)$ ]]; then
            (cd "$target_dir" && docker compose up -d)
            echo -e "${C_GREEN}✔ Tüm konteynerler başarıyla başlatıldı!${C_RESET}"
          fi
        fi
        ;;

      *)
        echo "Kullanım: ydev install [cli|stack]"
        ;;
    esac
    ;;

  status|ping)
    start_time=$(date +%s%3N 2>/dev/null || date +%s)
    res=$(req GET "/api/v1/notes?limit=1")
    end_time=$(date +%s%3N 2>/dev/null || date +%s)
    diff=$(( end_time - start_time ))
    if echo "$res" | grep -q '"success":true'; then
      echo -e "${C_GREEN}✔ YDevHub REST API Aktif & Sağlıklı!${C_RESET}"
      echo -e "  URL:     ${API_URL}"
      echo -e "  Gecikme: ~${diff} ms"
      echo -e "  Auth:    Geçerli X-API-Key"
    else
      echo -e "${C_RED}❌ YDevHub API yanıt vermedi veya yetkilendirme hatası.${C_RESET}" >&2
      exit 1
    fi

    echo ""
    ynet_res=$(curl -s -X GET "${YNETMON_URL}/api/v1/integration/summary" \
      -H "X-API-Key: ${YNETMON_KEY}" \
      --connect-timeout 2 --max-time 4 2>/dev/null || true)

    if echo "$ynet_res" | grep -q '"service":"YNetMon"'; then
      echo -e "${C_GREEN}✔ YNetMon Entegrasyon API Aktif & Sağlıklı!${C_RESET}"
      echo -e "  URL:     ${YNETMON_URL}"
      echo -e "  Mod:     $(echo "$ynet_res" | parse_json -r '.capture_mode')"
    else
      echo -e "${C_YELLOW}⚠️  YNetMon servisine ulaşılamadı (${YNETMON_URL}).${C_RESET}"
    fi
    ;;

  config)
    echo -e "${C_BOLD}⚙️  YDevHub & Homelab CLI Yapılandırması:${C_RESET}"
    echo "  Config Dosyası: ${CONFIG_FILE}"
    echo "  YDevHub URL:    ${API_URL}"
    echo "  YDevHub Key:    ${API_KEY:0:10}****************"
    echo "  YNetMon URL:    ${YNETMON_URL}"
    echo "  YNetMon Key:    ${YNETMON_KEY:0:10}****************"
    ;;

  *)
    show_help
    ;;
esac
